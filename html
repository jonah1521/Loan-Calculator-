  <script>
    // DOM Element References (Data Layer Access)
    const form = document.getElementById("loan-form");
    const amountInput = document.getElementById("amount");
    const rateInput = document.getElementById("rate");
    const yearsInput = document.getElementById("years");

    const monthlyOutput = document.getElementById("monthly-payment");
    const displayPrincipalOutput = document.getElementById("display-principal");
    const totalOutput = document.getElementById("total-paid");
    const interestOutput = document.getElementById("total-interest");
    const countOutput = document.getElementById("payment-count");
    const errorOutput = document.getElementById("error-message");

    // Format numbers as USD currency
    function formatMoney(value) {
      return value.toLocaleString("en-US", {
        style: "currency",
        currency: "USD"
      });
    }

    /**
     * PROCESSING LAYER: Performs business logic and compounding calculations.
     */
    function calculateLoan(principal, annualRate, years) {
      const numberOfPayments = years * 12;
      const monthlyRate = annualRate / 100 / 12;

      let monthlyPayment;

      if (monthlyRate === 0) {
        monthlyPayment = principal / numberOfPayments;
      } else {
        const growth = Math.pow(1 + monthlyRate, numberOfPayments);
        monthlyPayment = (principal * (monthlyRate * growth)) / (growth - 1);
      }

      const totalPaid = monthlyPayment * numberOfPayments;
      const totalInterest = totalPaid - principal;

      return {
        principal,
        monthlyPayment,
        totalPaid,
        totalInterest,
        numberOfPayments
      };
    }

